<Project>

  <!-- The rest of the build — language, nullable, docs, analyzers, warnings as errors — is Snail.Sdk's (global.json). -->

  <!--
    Migration debt, to be paid before the first release:
    RS0026 (22: the two overloads of ListJobsAsync, ListAllocationsAsync, ListEvaluationsAsync, ListNodesAsync and
    RegisterJobAsync on INomadClient and on NomadClient, and of AddNomad) — overloads that both take optional parameters.
    Removing a default changes how every caller writes the call, a decision about the API rather than a migration.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);RS0026</NoWarn>
  </PropertyGroup>

  <!--
    Migration debt, until Snail.Toolkit.HttpBuilder.Extensions 0.4.0 is on NuGet: the library takes 0.4.0-local.1 from the
    local feed, and a package of a stable version may not depend on a prerelease (NU5104). The release step moves the
    dependency to 0.4.0 and removes this line.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

</Project>
