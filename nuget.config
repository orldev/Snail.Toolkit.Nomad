<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Central package management with more than one feed configured requires an explicit mapping (NU1507). Without it a
    public package can shadow a private one of the same name, which is the dependency-confusion attack. Sources
    themselves stay in the user-level configuration; only the routing is pinned here. Every package, the Snail ones
    included, is on NuGet, so everything resolves there and the local feed is never consulted.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
