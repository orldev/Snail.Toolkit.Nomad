<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageId>Snail.Toolkit.Nomad</PackageId>
        <PackageTags>Nomad;HashiCorp;scheduler;jobs;HCL;allocations</PackageTags>
        <Title>Snail.Toolkit.Nomad</Title>
        <Authors>orldev</Authors>
        <Description>Typed client for the HashiCorp Nomad HTTP API over IHttpClientFactory: parse HCL2 jobs with variables, register, read, list, scale and stop jobs, read allocations, evaluations, nodes and task logs.</Description>
        <RepositoryUrl>https://github.com/orldev/Snail.Toolkit.Nomad</RepositoryUrl>
        <Copyright>Toolkit, 2023-2026</Copyright>
        <PackageProjectUrl>https://github.com/orldev/Snail.Toolkit.Nomad</PackageProjectUrl>
        <RepositoryType>GitHub</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <Version>0.2.1</Version>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
        <PackageReference Include="Snail.Toolkit.HttpBuilder.Extensions" Version="0.3.0" />
    </ItemGroup>

</Project>
