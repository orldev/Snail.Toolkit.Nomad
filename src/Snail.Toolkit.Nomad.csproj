<Project Sdk="Snail.Sdk.Library">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>Snail.Toolkit.Nomad</PackageId>
        <PackageTags>Nomad;HashiCorp;scheduler;jobs;HCL;allocations</PackageTags>
        <Title>Snail.Toolkit.Nomad</Title>
        <Authors>orldev</Authors>
        <Description>Typed client for the HashiCorp Nomad HTTP API over IHttpClientFactory: parse HCL2 jobs with variables, register, read, list, scale and stop jobs, read allocations, evaluations, nodes and task logs.</Description>
        <RepositoryUrl>https://github.com/orldev/Snail.Toolkit.Nomad</RepositoryUrl>
        <Copyright>Toolkit, 2023-2026</Copyright>
        <PackageProjectUrl>https://github.com/orldev/Snail.Toolkit.Nomad</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <Version>0.3.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
        <PackageReference Include="Snail.Toolkit.HttpBuilder.Extensions" />
    </ItemGroup>

</Project>
